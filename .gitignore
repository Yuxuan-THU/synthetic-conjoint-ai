# Sensitive information and local credentials
.env
.env.*
!.env.example
credentials/
secrets/
*.pem
*.key

# Raw and derived data are excluded by default
# 本项目例外：冻结的研究工具（问卷）、treatment 材料（法规文本）与冻结任务矩阵
# 体积小、不含隐私、且是复现所必需，因此纳入版本控制。
# 模型原始响应体量较大，继续排除，投稿时单独打包发布（见 README）。
data/raw/*
!data/raw/.gitkeep
!data/raw/instrument/
!data/raw/legal_texts/
!data/raw/design/
data/raw/responses/
outputs/data/**
!outputs/data/.gitkeep

# Large model artifacts and run stores
outputs/models/**
outputs/other/**
!outputs/models/.gitkeep
!outputs/other/.gitkeep
mlruns/
wandb/
checkpoints/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# R
.Rhistory
.RData
.Ruserdata
renv/library/
renv/staging/

# LaTeX temporary files
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc

# Office temporary and lock files
~$*.docx
~$*.doc
~$*.pptx
~$*.ppt
~$*.xlsx

# Quarto and generated manuscript caches
.quarto/
_freeze/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
