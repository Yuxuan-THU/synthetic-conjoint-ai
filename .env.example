# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，切勿提交。
# ---------------------------------------------------------------------------

# DeepSeek（中国开源模型，首批主跑）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 智谱 GLM（中国闭源，候选）
ZHIPUAI_API_KEY=
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 豆包 / 火山方舟（中国闭源，备选）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# OpenAI（美国闭源，Huhe 侧）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic（美国闭源，Huhe 侧）
ANTHROPIC_API_KEY=

# 运行环境
# 项目根目录留空则自动推断
PROJECT_ROOT=
# 日志级别：DEBUG / INFO / WARNING
LOG_LEVEL=INFO
